<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF removes these standard SDK implicit usings; existing service tests use them. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SteamRecordingBrowser/SteamRecordingBrowser.csproj" />
    <Content Include="../../src/SteamRecordingBrowser/App.xaml" Link="TestResources/App.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/SteamRecordingBrowser/MainWindow.xaml" Link="TestResources/MainWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
