<Window x:Class="SteamRecordingBrowser.Dialogs.TextEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#151922"
        Foreground="#F4F7FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBox x:Name="ValueBox" Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="#11151C" Foreground="#F4F7FB"
                 BorderBrush="#2B3240" Padding="10"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
