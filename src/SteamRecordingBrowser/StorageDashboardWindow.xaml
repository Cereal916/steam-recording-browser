<Window x:Class="SteamRecordingBrowser.StorageDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storage dashboard"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0D1015"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="DashboardSurface" Color="#151922"/>
        <SolidColorBrush x:Key="DashboardBorder" Color="#2B3240"/>
        <SolidColorBrush x:Key="DashboardMuted" Color="#98A2B3"/>
        <SolidColorBrush x:Key="DashboardAccent" Color="#66C0F4"/>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DashboardSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <Style x:Key="DashboardListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#252C38"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#1C2430"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#213147"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#3E617B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource DashboardAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Storage dashboard" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="See where recording space is going and find footage stored in more than one place."
                           Foreground="{StaticResource DashboardMuted}"
                           Margin="0,6,24,0" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close" MinWidth="88"
                    VerticalAlignment="Center" Click="Close_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SummaryCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total storage" Foreground="{StaticResource DashboardMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalSizeText}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding GameCountText}" Foreground="#C0C8D4" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SummaryCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Saved clips" Foreground="{StaticResource DashboardMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding SavedClipSizeText}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SavedClipCountText}" Foreground="#C0C8D4" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Rolling recordings" Foreground="{StaticResource DashboardMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding RollingRecordingSizeText}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding RollingSessionCountText}" Foreground="#C0C8D4" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource SummaryCard}" BorderBrush="#3F6E87">
                <StackPanel>
                    <TextBlock Text="Overlapping footage" Foreground="#8FD5FA" FontSize="12"/>
                    <TextBlock Text="{Binding OverlapDurationText}" FontSize="25" FontWeight="SemiBold"
                               Foreground="{StaticResource DashboardAccent}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding OverlapSummaryText}" Foreground="#C0C8D4" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="490"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource DashboardSurface}"
                    BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1"
                    CornerRadius="7" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,14,16,12">
                        <TextBlock Text="Space by game" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Games are ordered by total storage used."
                                   Foreground="{StaticResource DashboardMuted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Grid.RowSpan="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MinWidth="580">
                            <Border Background="#11161E" BorderBrush="#2B3240" BorderThickness="0,1">
                                <Grid Margin="14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GAME" Foreground="{StaticResource DashboardMuted}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="TOTAL" Foreground="{StaticResource DashboardMuted}" FontSize="11" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="SAVED" Foreground="{StaticResource DashboardMuted}" FontSize="11" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="ROLLING" Foreground="{StaticResource DashboardMuted}" FontSize="11" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="OVERLAP" Foreground="#8FD5FA" FontSize="11" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Games}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#242C37" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#222B37"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="14,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="160"/>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="86"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RecordingCountText}" Foreground="{StaticResource DashboardMuted}"
                                                               FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SavedClipSizeText}" TextAlignment="Right" VerticalAlignment="Center" Foreground="#D6DCE5"/>
                                                <TextBlock Grid.Column="3" Text="{Binding RollingRecordingSizeText}" TextAlignment="Right" VerticalAlignment="Center" Foreground="#D6DCE5"/>
                                                <TextBlock Grid.Column="4" Text="{Binding OverlapDurationText}" TextAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="{StaticResource DashboardAccent}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource DashboardSurface}"
                    BorderBrush="{StaticResource DashboardBorder}" BorderThickness="1"
                    CornerRadius="7" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,14,16,12">
                        <TextBlock Text="Oldest recordings" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Oldest items appear first."
                                   Foreground="{StaticResource DashboardMuted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="OldestRecordingList" Grid.Row="1"
                             ItemsSource="{Binding OldestRecordings}"
                             Background="Transparent" BorderBrush="#2B3240" BorderThickness="0,1,0,0"
                             ItemContainerStyle="{StaticResource DashboardListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#D6DCE5" Margin="12,0,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TimestampText}"
                                               Foreground="{StaticResource DashboardMuted}" FontSize="11" Margin="0,4,0,0"/>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding RecordingType}" Foreground="#AAB4C2" FontSize="11"/>
                                        <TextBlock Text="  •  " Foreground="#657081" FontSize="11"/>
                                        <TextBlock Text="{Binding DurationText}" Foreground="#AAB4C2" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#11161E" BorderBrush="#28313E" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,14,0,0">
            <TextBlock Foreground="#AAB4C2" FontSize="11.5" TextWrapping="Wrap" LineHeight="17">
                <Run Text="Overlap: "/><Run FontWeight="SemiBold" Foreground="#D7DEE8"
                    Text="saved-clip time that is also present in the matching rolling recording."/>
                <Run Text=" Rolling footage may expire, so overlap is informational only. This dashboard never changes or deletes recording files."/>
            </TextBlock>
        </Border>
    </Grid>
</Window>
