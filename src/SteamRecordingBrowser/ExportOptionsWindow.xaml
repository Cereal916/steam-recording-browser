<Window x:Class="SteamRecordingBrowser.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export options"
        Width="650"
        Height="890"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1015"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Export MP4" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Choose how the video should be encoded."
                       Foreground="#98A2B3" Margin="0,7,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
        <UniformGrid Columns="2">
            <Button x:Name="OriginalButton" Tag="Original" Click="CodecButton_Click" Margin="0,0,7,7" Padding="14">
                <StackPanel>
                    <TextBlock Text="Original codec" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="OriginalCodecText" Foreground="#98A2B3" Margin="0,5,0,0"/>
                    <TextBlock x:Name="OriginalBitrateText" Foreground="#66C0F4" Margin="0,5,0,0"/>
                    <TextBlock x:Name="OriginalSizeText" Foreground="#D5DBE5" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="H264Button" Tag="H264" Click="CodecButton_Click" Margin="7,0,0,7" Padding="14">
                <StackPanel>
                    <TextBlock Text="H.264" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Best for social uploads" Foreground="#66C0F4" Margin="0,5,0,0"/>
                    <TextBlock x:Name="H264BitrateText" Text="12 Mbps video + 192 Kbps AAC" Foreground="#98A2B3" Margin="0,5,0,0"/>
                    <TextBlock x:Name="H264SizeText" Foreground="#D5DBE5" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="HevcButton" Tag="Hevc" Click="CodecButton_Click" Margin="0,7,7,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="HEVC / H.265" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Smaller files • slower" Foreground="#98A2B3" Margin="0,5,0,0"/>
                    <TextBlock x:Name="HevcBitrateText" Text="8 Mbps video + 192 Kbps AAC" Foreground="#66C0F4" Margin="0,5,0,0"/>
                    <TextBlock x:Name="HevcSizeText" Foreground="#D5DBE5" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="Av1Button" Tag="Av1" Click="CodecButton_Click" Margin="7,7,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="AV1" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Smallest files • slowest" Foreground="#98A2B3" Margin="0,5,0,0"/>
                    <TextBlock x:Name="Av1BitrateText" Text="6 Mbps video + 192 Kbps AAC" Foreground="#66C0F4" Margin="0,5,0,0"/>
                    <TextBlock x:Name="Av1SizeText" Foreground="#D5DBE5" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </UniformGrid>
            <TextBlock Text="Size accuracy: Original is generally within a few percent. Transcoded estimates are rough and may vary by about ±20% depending on video complexity, encoder behavior, audio, and MP4 overhead."
                       Foreground="#98A2B3"
                       FontSize="12"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="2,12,2,0"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16"
                Background="#151922" BorderBrush="#2B3240"
                BorderThickness="1" CornerRadius="7">
            <StackPanel>
                <TextBlock x:Name="SelectedCodecText" FontWeight="SemiBold" Foreground="#66C0F4"/>
                <TextBlock x:Name="CodecHintText" Margin="0,7,0,0" Foreground="#D5DBE5"
                           TextWrapping="Wrap" LineHeight="19"/>
                <Border Height="1" Background="#2B3240" Margin="0,14,0,13"/>
                <CheckBox x:Name="HardwareEncodingCheckBox"
                          Content="Use hardware encoding when available"
                          IsChecked="True"
                          Click="HardwareEncoding_Changed"
                          FontWeight="SemiBold"/>
                <TextBlock x:Name="EncodingModeText" Margin="24,7,0,0"
                           Foreground="#98A2B3" TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="16"
                Background="#11151C" BorderBrush="#252C38"
                BorderThickness="1" CornerRadius="7">
            <StackPanel>
                <TextBlock Text="Upload guidance" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Margin="0,10,0,0" Foreground="#D5DBE5" TextWrapping="Wrap" LineHeight="20">
                    <Run Text="For YouTube, Twitch, TikTok, Instagram, and Facebook, H.264 is the safest and most portable upload choice and will usually process fastest."/>
                    <LineBreak/><LineBreak/><Run Text="Original preserves maximum source quality. HEVC and AV1 can reduce file size, but uploads may take longer to process and support varies by service and device." Foreground="#98A2B3"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="92" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="Continue…" Width="112" IsDefault="True" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
