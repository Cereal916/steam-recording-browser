<Window x:Class="SteamRecordingBrowser.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Steam Recording Browser — Player"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#090B0F"
        Foreground="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#1B202B"/>
            <Setter Property="BorderBrush" Value="#343C49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#263142"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A596E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#10151D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#66C0F4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#667080"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkVolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5"
                                                        Background="#66C0F4"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5"
                                                        Background="#343C49"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="VolumeThumb"
                                                         Fill="#F4F7FB"
                                                         Stroke="#66C0F4"
                                                         StrokeThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="VolumeThumb" Property="Fill" Value="#FFFFFF"/>
                                                        <Setter TargetName="VolumeThumb" Property="Stroke" Value="#8DD4FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="VolumeThumb" Property="Fill" Value="#66C0F4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTimelineSlider" TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="12"
                                    Background="#0B0E13"
                                    BorderBrush="#2F3744"
                                    BorderThickness="1"
                                    CornerRadius="6"/>
                            <Track x:Name="PART_Track" Margin="3,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        Background="#4FA9DD"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        Background="#252C37"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="TimelineThumb"
                                                        Background="#F4F7FB"
                                                        BorderBrush="#66C0F4"
                                                        BorderThickness="2"
                                                        CornerRadius="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000"
                                                                          BlurRadius="5"
                                                                          ShadowDepth="1"
                                                                          Opacity="0.55"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TimelineThumb" Property="Background" Value="#FFFFFF"/>
                                                        <Setter TargetName="TimelineThumb" Property="BorderBrush" Value="#8DD4FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="TimelineThumb" Property="Background" Value="#66C0F4"/>
                                                        <Setter TargetName="TimelineThumb" Property="BorderBrush" Value="#B8E5FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Black">
            <vlc:VideoView x:Name="VideoView" Focusable="False"/>

        </Grid>

        <Grid Grid.Row="1" Background="#151922">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="54"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseButton" Content="Pause" Width="82" Height="36" Margin="14,0"
                        Click="PlayPause_Click"/>
                <Grid Grid.Column="1" Margin="8,0">
                    <Slider x:Name="Timeline"
                            Style="{StaticResource DarkTimelineSlider}"
                            Minimum="0" Maximum="1"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            PreviewMouseDown="Timeline_PreviewMouseDown"
                            PreviewMouseUp="Timeline_PreviewMouseUp"
                            PreviewMouseMove="Timeline_PreviewMouseMove"
                            MouseEnter="Timeline_MouseEnter"
                            MouseLeave="Timeline_MouseLeave"
                            ValueChanged="Timeline_ValueChanged"
                            KeyDown="Timeline_KeyDown"
                            ToolTip="Click to seek • drag to scrub • hover for frame preview • ←/→ ±5 sec"/>

                    <Popup x:Name="TimelinePreviewPopup"
                           Placement="Absolute"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           IsHitTestVisible="False">
                        <Border Background="#0A0D12"
                                BorderBrush="#46556B"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="6">
                            <StackPanel>
                                <Border Width="320" Height="180"
                                        Background="#030507"
                                        ClipToBounds="True"
                                        CornerRadius="3">
                                    <Grid>
                                        <vlc:VideoView x:Name="PreviewVideoView"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="PreviewTimeLabel"
                                           Text="0:00"
                                           HorizontalAlignment="Center"
                                           Foreground="#F4F7FB"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <TextBlock x:Name="TimeLabel"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="14,0"
                           Foreground="#D5DBE5"
                           Text="0:00 / 0:00"/>
                <Border Grid.Column="3"
                        Margin="0,0,14,0"
                        Padding="5,4,8,4"
                        VerticalAlignment="Center"
                        Background="#10141B"
                        BorderBrush="#343C49"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MuteButton"
                                Content="Mute"
                                Width="58"
                                Height="30"
                                Padding="8,4"
                                ToolTip="Mute or unmute audio"
                                Click="MuteButton_Click"/>
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource DarkVolumeSlider}"
                                Width="96"
                                Margin="10,0,7,0"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                SmallChange="5"
                                LargeChange="10"
                                ToolTip="Volume"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeValueText"
                                   Width="38"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="#D5DBE5"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="100%"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" BorderBrush="#2B3240" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,8">
                    <TextBlock x:Name="ClipInfoText"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="#98A2B3"
                               Margin="2,0,16,0"/>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="FavoriteButton"
                                Content="☆ Favorite"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Click="Favorite_Click"/>
                        <Button Content="Description…"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Click="Description_Click"/>
                        <Button Content="Tags…"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Click="Tags_Click"/>
                        <Button Content="Export MP4…"
                                Padding="12,6"
                                Click="Export_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2"
                    BorderBrush="#2B3240"
                    BorderThickness="0,1,0,0"
                    Background="#11151C"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Description"
                                   Foreground="#98A2B3"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="DescriptionText"
                                   Foreground="#E6EAF0"
                                   TextWrapping="Wrap"
                                   MaxHeight="54"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Tags"
                                   Foreground="#98A2B3"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,3"/>
                        <TextBlock x:Name="TagsText"
                                   Foreground="#E6EAF0"
                                   TextWrapping="Wrap"
                                   MaxHeight="54"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
