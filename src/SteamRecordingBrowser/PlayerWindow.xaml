<Window x:Class="SteamRecordingBrowser.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Steam Recording Browser — Player"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#090B0F"
        Foreground="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#1B202B"/>
            <Setter Property="BorderBrush" Value="#343C49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#263142"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A596E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#10151D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#66C0F4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#667080"/>
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TimestampTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#0B0E13"/>
            <Setter Property="BorderBrush" Value="#46556B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#66C0F4"/>
        </Style>
        <Style x:Key="DarkVolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5"
                                                        Background="#66C0F4"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5"
                                                        Background="#343C49"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="VolumeThumb"
                                                         Fill="#F4F7FB"
                                                         Stroke="#66C0F4"
                                                         StrokeThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="VolumeThumb" Property="Fill" Value="#FFFFFF"/>
                                                        <Setter TargetName="VolumeThumb" Property="Stroke" Value="#8DD4FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="VolumeThumb" Property="Fill" Value="#66C0F4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTimelineSlider" TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="12"
                                    Background="#0B0E13"
                                    BorderBrush="#2F3744"
                                    BorderThickness="1"
                                    CornerRadius="6"/>
                            <Track x:Name="PART_Track" Margin="3,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        Background="#4FA9DD"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        Background="#252C37"
                                                        CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="22">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="TimelineThumb"
                                                        Background="#F4F7FB"
                                                        BorderBrush="#66C0F4"
                                                        BorderThickness="2"
                                                        CornerRadius="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000"
                                                                          BlurRadius="5"
                                                                          ShadowDepth="1"
                                                                          Opacity="0.55"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TimelineThumb" Property="Background" Value="#FFFFFF"/>
                                                        <Setter TargetName="TimelineThumb" Property="BorderBrush" Value="#8DD4FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="TimelineThumb" Property="Background" Value="#66C0F4"/>
                                                        <Setter TargetName="TimelineThumb" Property="BorderBrush" Value="#B8E5FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000000">
            <vlc:VideoView x:Name="VideoView"
                           Focusable="False"
                           Background="#000000">
                <!-- LibVLCSharp renders VideoView content in its foreground
                     HWND, above the native Direct3D surface. Keep this cover
                     visible until decoded timestamps advance so native white
                     clears can never reach the user during source changes. -->
                <Border x:Name="VideoTransitionCover"
                        Background="#000000"
                        IsHitTestVisible="False"/>
            </vlc:VideoView>
            <Border x:Name="LivePlaybackBadge"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="18" Padding="10,6"
                    Background="#E0A21E2B" BorderBrush="#FF6673"
                    BorderThickness="1" CornerRadius="5"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FFFFFF" Margin="0,0,7,0"/>
                    <TextBlock Text="LIVE AUTO RECORDING" Foreground="#FFFFFF"
                               FontWeight="Bold" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Background="#151922">
            <Grid.RowDefinitions>
                <RowDefinition Height="116"/>
                <RowDefinition Height="54"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="14,2,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>
                    <Slider x:Name="Timeline"
                            Style="{StaticResource DarkTimelineSlider}"
                            Minimum="0" Maximum="1"
                            SmallChange="0.01"
                            LargeChange="0.05"
                            PreviewMouseDown="Timeline_PreviewMouseDown"
                            PreviewMouseUp="Timeline_PreviewMouseUp"
                            PreviewMouseMove="Timeline_PreviewMouseMove"
                            MouseEnter="Timeline_MouseEnter"
                            MouseLeave="Timeline_MouseLeave"
                            ValueChanged="Timeline_ValueChanged"
                            KeyDown="Timeline_KeyDown"
                            ToolTip="Click to seek • drag to scrub • Shift+drag for fine control • hover for frame preview • blue markers indicate new sessions"/>

                    <Canvas x:Name="TimelineTickCanvas"
                            Grid.Row="1"
                            Height="18"
                            SizeChanged="TimelineTickCanvas_SizeChanged"/>

                    <Button x:Name="TimeButton"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Margin="0,1,0,0"
                            Padding="10,1"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            ToolTip="Go to an exact timestamp"
                            Click="ExactTime_Click">
                        <TextBlock x:Name="TimeLabel"
                                   Foreground="#B8C2D0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="0:00 / 0:00"/>
                    </Button>

                    <Popup x:Name="TimelinePreviewPopup"
                           Placement="Absolute"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           IsHitTestVisible="False">
                        <Border Background="#0A0D12"
                                BorderBrush="#46556B"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="6">
                            <StackPanel>
                                <Border Width="320" Height="180"
                                        Background="#030507"
                                        ClipToBounds="True"
                                        CornerRadius="3">
                                    <Grid>
                                        <vlc:VideoView x:Name="PreviewVideoView"
                                                       Background="#000000"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="PreviewTimeLabel"
                                           Text="0:00"
                                           HorizontalAlignment="Center"
                                           Foreground="#F4F7FB"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="ExactTimePopup"
                       PlacementTarget="{Binding ElementName=TimeButton}"
                       Placement="Bottom"
                       HorizontalOffset="0"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       StaysOpen="False">
                    <Border Width="250"
                            Padding="12"
                            Background="#11151C"
                            BorderBrush="#46556B"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="12"
                                              ShadowDepth="3"
                                              Opacity="0.65"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Go to timestamp"
                                       Foreground="#F4F7FB"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExactTimeBox"
                                         Style="{StaticResource TimestampTextBox}"
                                         ToolTip="Seconds, MM:SS, or HH:MM:SS"
                                         KeyDown="ExactTimeBox_KeyDown"/>
                                <Button Grid.Column="1"
                                        Content="Go"
                                        Width="48"
                                        Margin="8,0,0,0"
                                        Click="ApplyExactTime_Click"/>
                            </Grid>
                            <TextBlock x:Name="TimestampValidationText"
                                       Foreground="#FF8A8A"
                                       FontSize="11"
                                       Margin="1,6,0,0"
                                       Visibility="Collapsed"/>
                            <TextBlock Text="Enter to seek  •  Esc to close"
                                       Foreground="#7F8998"
                                       FontSize="10"
                                       Margin="1,6,0,0"/>
                        </StackPanel>
                    </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,8,4">
                    <Button x:Name="PlayPauseButton"
                            Content="Pause"
                            Width="82"
                            Height="34"
                            Margin="0,0,12,0"
                            Click="PlayPause_Click"/>
                    <Button Content="−30s" Width="54" Height="32" Padding="6,4" Margin="0,0,6,0"
                            Tag="-30000" ToolTip="Back 30 seconds" Click="SeekButton_Click"/>
                    <Button Content="−5s" Width="46" Height="32" Padding="6,4" Margin="0,0,6,0"
                            Tag="-5000" ToolTip="Back 5 seconds" Click="SeekButton_Click"/>
                    <Button Content="+5s" Width="46" Height="32" Padding="6,4" Margin="0,0,6,0"
                            Tag="5000" ToolTip="Forward 5 seconds" Click="SeekButton_Click"/>
                    <Button Content="+30s" Width="54" Height="32" Padding="6,4"
                            Tag="30000" ToolTip="Forward 30 seconds" Click="SeekButton_Click"/>
                    <Button x:Name="GoLiveButton" Content="● LIVE" Height="32" MinWidth="72"
                            Margin="8,0,0,0" Padding="9,4" Visibility="Collapsed"
                            Foreground="#FFFFFF" Background="#8F1D28" BorderBrush="#FF6673"
                            ToolTip="Jump to the newest playable segment" Click="GoLive_Click"/>
                    <Border Width="36"
                            Height="32"
                            Margin="8,0,0,0"
                            Background="#10141B"
                            BorderBrush="#343C49"
                            BorderThickness="1"
                            CornerRadius="5"
                            Cursor="Help"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="30000">
                        <TextBlock Text="⌨"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#B8C2D0"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="17"/>
                        <Border.ToolTip>
                            <ToolTip Placement="Top"
                                     HorizontalOffset="0"
                                     VerticalOffset="-4"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <Border Width="270"
                                        Padding="13,11"
                                        Background="#0C1016"
                                        BorderBrush="#46556B"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000"
                                                          BlurRadius="12"
                                                          ShadowDepth="3"
                                                          Opacity="0.65"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Keyboard shortcuts"
                                                   Foreground="#F4F7FB"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Space" Foreground="#8DD4FF" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Play / pause" Foreground="#D5DBE5"/>
                                            <TextBlock Grid.Row="1" Text="Shift + drag" Foreground="#8DD4FF" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Fine timeline scrub" Foreground="#D5DBE5" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Text="Mouse wheel" Foreground="#8DD4FF" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Seek 5 seconds" Foreground="#D5DBE5" Margin="0,5,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,14,0"
                        Padding="5,4,8,4"
                        VerticalAlignment="Center"
                        Background="#10141B"
                        BorderBrush="#343C49"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MuteButton"
                                Content="Mute"
                                Width="58"
                                Height="30"
                                Padding="8,4"
                                ToolTip="Mute or unmute audio"
                                Click="MuteButton_Click"/>
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource DarkVolumeSlider}"
                                Width="96"
                                Margin="10,0,7,0"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                SmallChange="5"
                                LargeChange="10"
                                ToolTip="Volume"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeValueText"
                                   Width="38"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Foreground="#D5DBE5"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="100%"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" BorderBrush="#2B3240" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,8">
                    <TextBlock x:Name="ClipInfoText"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Foreground="#98A2B3"
                               Margin="2,0,16,0"/>

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="FavoriteButton"
                                Content="☆ Favorite"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Click="Favorite_Click"/>
                        <Button Content="Export MP4…"
                                Padding="12,6"
                                Click="Export_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2"
                    BorderBrush="#2B3240"
                    BorderThickness="0,1,0,0"
                    Background="#11151C"
                    Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,9,0"
                            Padding="12,10"
                            Background="#0C1016"
                            BorderBrush="#2B3442"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Right"
                                        Content="Edit"
                                        Padding="9,3"
                                        FontSize="11"
                                        Click="Description_Click"/>
                                <Border DockPanel.Dock="Left"
                                        Width="3"
                                        Height="14"
                                        Margin="0,0,7,0"
                                        Background="#66C0F4"
                                        CornerRadius="2"/>
                                <TextBlock Text="DESCRIPTION"
                                           VerticalAlignment="Center"
                                           Foreground="#98A2B3"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </DockPanel>
                            <TextBlock x:Name="DescriptionText"
                                       Foreground="#E6EAF0"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       MaxHeight="58"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="9,0,0,0"
                            Padding="12,10"
                            Background="#0C1016"
                            BorderBrush="#2B3442"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <Button DockPanel.Dock="Right"
                                        Content="Edit"
                                        Padding="9,3"
                                        FontSize="11"
                                        Click="Tags_Click"/>
                                <Border DockPanel.Dock="Left"
                                        Width="3"
                                        Height="14"
                                        Margin="0,0,7,0"
                                        Background="#66C0F4"
                                        CornerRadius="2"/>
                                <TextBlock Text="TAGS"
                                           VerticalAlignment="Center"
                                           Foreground="#98A2B3"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </DockPanel>
                            <WrapPanel x:Name="TagsPanel"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
