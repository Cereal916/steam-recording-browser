<Window x:Class="SteamRecordingBrowser.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live application log"
        Width="1050" Height="680" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#0D1015" Foreground="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#11151C"/>
            <Setter Property="BorderBrush" Value="#343C49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Live application log" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="New entries appear here as they are written. The display keeps the latest 5,000 entries."
                           Foreground="#98A2B3" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseButton" Content="Pause" MinWidth="82" Click="Pause_Click"/>
                <Button Content="Clear display" MinWidth="110" Margin="8,0,0,0" Click="Clear_Click"
                        ToolTip="Clear this window without deleting the log file"/>
                <Button Content="Copy selected" MinWidth="112" Margin="8,0,0,0" Click="CopySelected_Click"
                        ToolTip="Copy selected entries (Ctrl+C)"/>
                <Button Content="Open file" MinWidth="92" Margin="8,0,0,0" Click="OpenFile_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="DebugFilterToggle" Content="Debug" IsChecked="False"
                          Foreground="#8994A5" Margin="0,0,14,0" Click="LevelFilter_Click"/>
                <CheckBox x:Name="InfoFilterToggle" Content="Info" IsChecked="True"
                          Foreground="#D5DBE5" Margin="0,0,14,0" Click="LevelFilter_Click"/>
                <CheckBox x:Name="WarnFilterToggle" Content="Warn" IsChecked="True"
                          Foreground="#F2C46D" Margin="0,0,14,0" Click="LevelFilter_Click"/>
                <CheckBox x:Name="ErrorFilterToggle" Content="Error" IsChecked="True"
                          Foreground="#FF8585" Click="LevelFilter_Click"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,14,0"
                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter log messages"/>
            <CheckBox x:Name="AutoScrollCheckBox" Grid.Column="2" Content="Auto-scroll"
                      IsChecked="True" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="2" Background="#090C11" BorderBrush="#2B3240"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <ListBox x:Name="LogList"
                     Background="Transparent" BorderThickness="0"
                     SelectionMode="Extended"
                     PreviewKeyDown="LogList_PreviewKeyDown"
                     ItemsSource="{Binding Entries}"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12.5"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.ScrollChanged="LogList_ScrollChanged"
                     PreviewMouseWheel="LogList_PreviewMouseWheel">
                <ListBox.ContextMenu>
                    <ContextMenu Background="#151922" BorderBrush="#343C49" Foreground="#F4F7FB">
                        <MenuItem Header="Copy selected" Click="CopySelected_Click"
                                  Background="#151922" Foreground="#F4F7FB"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Foreground" Value="#D5DBE5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                <Setter Property="Foreground" Value="#8994A5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="WARN">
                                <Setter Property="Foreground" Value="#F2C46D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                <Setter Property="Foreground" Value="#FF8585"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#253044"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18202B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="2,10,2,0">
            <TextBlock x:Name="StatusText" Foreground="#98A2B3"/>
            <TextBlock Text="Scrolling upward pauses auto-scroll; re-enable it to follow the newest entry."
                       Foreground="#667080" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
