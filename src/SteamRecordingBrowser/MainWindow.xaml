<Window x:Class="SteamRecordingBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Steam Recording Browser"
        Width="1180" Height="820"
        MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0D1015"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#151922"/>
        <SolidColorBrush x:Key="Surface2" Color="#1B202B"/>
        <SolidColorBrush x:Key="Border" Color="#2B3240"/>
        <SolidColorBrush x:Key="Text" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="Muted" Color="#98A2B3"/>
        <SolidColorBrush x:Key="Accent" Color="#66C0F4"/>

        <Style x:Key="ButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#11151C"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        <Setter Property="Background" Value="#151922"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#253044"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2C4058"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#667080"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="9,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <Border Grid.Column="1"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1,0,0,0"
                                            Background="#1B202B">
                                        <Path Width="8" Height="5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="#D7DEE8"
                                              Data="M 0 0 L 8 0 L 4 5 Z"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="#151922"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="340">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#46556B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#667080"/>
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#11151C"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="9,6"/>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TableColumnResizeGrip" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="Drag to resize column"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="ResizeCue" Width="1"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResizeCue" Property="Background" Value="#66C0F4"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ResizeCue" Property="Background" Value="#8FD5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="#C8D1DE"/>
            <Setter Property="Background" Value="#161C25"/>
            <Setter Property="BorderBrush" Value="#27303C"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      Margin="0,0,14,0"/>
                                    <Path x:Name="SortAscending" Visibility="Collapsed" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Fill="#66C0F4" Data="M 0 6 L 4 2 L 8 6 Z"/>
                                    <Path x:Name="SortDescending" Visibility="Collapsed" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Fill="#66C0F4" Data="M 0 2 L 4 6 L 8 2 Z"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource TableColumnResizeGrip}"
                                   HorizontalAlignment="Left" HorizontalContentAlignment="Left" Panel.ZIndex="10"
                                   DragCompleted="TableColumnResize_DragCompleted"/>
                            <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource TableColumnResizeGrip}"
                                   HorizontalAlignment="Right" HorizontalContentAlignment="Right" Panel.ZIndex="10"
                                   DragCompleted="TableColumnResize_DragCompleted"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#253044"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#2C4058"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortAscending" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortDescending" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#D5DBE5"/>
            <Setter Property="BorderBrush" Value="#242C37"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A4057"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#10141B"/>
            <Setter Property="Foreground" Value="#D5DBE5"/>
            <Setter Property="MinHeight" Value="38"/>
            <EventSetter Event="MouseEnter" Handler="RecordingCard_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="RecordingCard_MouseLeave"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#131821"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C2735"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#243A50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TableText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="#D5DBE5"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style x:Key="TableNumericText" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#B8C3D1"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12161E" BorderBrush="#252C38" BorderThickness="0,0,0,1">
            <StackPanel Margin="20,15">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Image Source="Assets/SteamRecordingBrowser_Logo.png" Width="54" Height="54"
                               Stretch="Uniform" Margin="0,0,13,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STEAM RECORDING BROWSER" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Browse • organize • play • export" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonStyle}" Content="Open log" Click="OpenLog_Click"/>
                        <Button Style="{StaticResource ButtonStyle}" Content="Settings" Click="Settings_Click"/>
                        <Button Style="{StaticResource ButtonStyle}" Content="Refresh" Click="Refresh_Click"/>
                    </StackPanel>
                </DockPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" LastChildFill="True">
                        <TextBlock Text="Search clips"
                                   Foreground="{StaticResource Muted}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Height="34"
                                     ToolTip="Search game names, descriptions, tags, and recording types"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchHint"
                                       Text="Game, description, tag, or type…"
                                       Foreground="#667080"
                                       VerticalAlignment="Center"
                                       Margin="11,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>

                    <ComboBox x:Name="GameFilter" Grid.Column="1" Width="190" Height="34" Margin="10,0,0,0"
                              SelectionChanged="GameFilter_SelectionChanged"/>
                    <ComboBox x:Name="TagFilter" Grid.Column="2" Width="150" Height="34" Margin="10,0,0,0"
                              SelectionChanged="TagFilter_SelectionChanged"/>
                    <ComboBox x:Name="SortFilter" Grid.Column="3" Width="135" Height="34" Margin="10,0,0,0"
                              SelectionChanged="SortFilter_SelectionChanged"/>
                    <CheckBox x:Name="FavoritesOnly" Grid.Column="4" Content="Favorites only" Foreground="{StaticResource Text}"
                              VerticalAlignment="Center" Margin="14,0,0,0"
                              Checked="FavoritesOnly_Changed" Unchecked="FavoritesOnly_Changed"/>
                </Grid>

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <StackPanel x:Name="FilterStatusPanel" DockPanel.Dock="Right"
                                Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock x:Name="FilterStatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ButtonStyle}" Content="Clear all filters" Click="ClearFilters_Click"/>
                    </StackPanel>
                </DockPanel>

                <ProgressBar x:Name="LoadProgress" Height="4" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Grid x:Name="ListLayoutPanel" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="86"/>
            </Grid.ColumnDefinitions>

        <ListView x:Name="RecordingList" Grid.Column="0"
                  Background="#0D1015" BorderThickness="0"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="RecordingList_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#151922" BorderBrush="#2B3240" BorderThickness="1"
                            MaxWidth="1040"
                            HorizontalAlignment="Stretch"
                            CornerRadius="9" Margin="8,5" Padding="12"
                            MouseEnter="RecordingCard_MouseEnter"
                            MouseLeave="RecordingCard_MouseLeave">
                        <Grid Height="118">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#0A0C10" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding DisplayImagePath}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Stretch" Value="UniformToFill"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                        <Setter Property="Stretch" Value="Uniform"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="No artwork available"
                                               Foreground="#667080"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FavoriteGlyph}" Foreground="#F6C85F" FontSize="16"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GameName}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F4F7FB" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Margin="10,0,6,0" Padding="7,2" CornerRadius="9"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#202733"/>
                                                <Setter Property="BorderBrush" Value="#343E4D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                        <Setter Property="Background" Value="#54232932"/>
                                                        <Setter Property="BorderBrush" Value="#A84D5B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RecordingTypeLabel}" Foreground="#BFC8D6"
                                                   FontSize="8" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Grid.Column="3" Width="22" Height="22" Background="#1A202A" BorderBrush="#384657"
                                            BorderThickness="1" CornerRadius="11" VerticalAlignment="Center"
                                            ToolTipService.ShowDuration="60000"
                                            ToolTip="{Binding VideoInfoText}">
                                        <TextBlock Text="i" Foreground="#8FBAD8" FontSize="12" FontWeight="SemiBold" FontStyle="Italic"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding DisplayTime}" Foreground="#929DAD" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding AnnotationDescription}" Foreground="#CDD4DF" Margin="0,9,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AnnotationTagDisplay}" Foreground="#71ABD0" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DurationText}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#F4F7FB" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding SizeText}" Foreground="#98A2B3" Margin="0,6,0,0"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ContextMenu>
                <ContextMenu Opened="RecordingContextMenu_Opened">
                    <MenuItem Header="Play" Click="PlayMenu_Click"/>
                    <MenuItem Header="Export to MP4…" Click="ExportMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Toggle favorite" Click="FavoriteMenu_Click"/>
                    <MenuItem Header="Edit description…" Tag="Annotation" Click="DescriptionMenu_Click"/>
                    <MenuItem Header="Add/edit tags…" Tag="Annotation" Click="TagsMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Open recording folder" Click="OpenFolderMenu_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

            <Border Grid.Column="1"
                    Background="#10141B"
                    BorderBrush="#252C38"
                    BorderThickness="1,0,0,0">
                <Canvas x:Name="DateTimelineCanvas"
                        Margin="5,10,4,10"
                        SizeChanged="DateTimelineCanvas_SizeChanged"
                        IsHitTestVisible="False"/>
            </Border>
        </Grid>

        <Grid x:Name="TileLayoutPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="86"/>
            </Grid.ColumnDefinitions>

        <ListView x:Name="TileRecordingList"
                  Grid.Column="0"
                  Background="#0D1015"
                  BorderThickness="0"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  MouseDoubleClick="RecordingList_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="7"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="252"
                            Height="238"
                            Padding="8"
                            Background="#151922"
                            BorderBrush="#2B3240"
                            BorderThickness="1"
                            CornerRadius="8"
                            MouseEnter="RecordingCard_MouseEnter"
                            MouseLeave="RecordingCard_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="135"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#080A0E" CornerRadius="5" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding DisplayImagePath}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Stretch" Value="UniformToFill"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                        <Setter Property="Stretch" Value="Uniform"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="No artwork available"
                                               Foreground="#667080"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="6"
                                            Padding="6,3"
                                            Background="#D9080A0E"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding DurationText}"
                                                   Foreground="#F4F7FB"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="3,9,3,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FavoriteGlyph}" Foreground="#F6C85F" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GameName}" Foreground="#F4F7FB"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Margin="5,0" Padding="5,2" BorderThickness="1" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E0242B38"/>
                                                <Setter Property="BorderBrush" Value="#536176"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                        <Setter Property="Background" Value="#E0A21E2B"/>
                                                        <Setter Property="BorderBrush" Value="#FF6673"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RecordingTypeLabel}" Foreground="#FFFFFF" FontSize="7" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="3" Width="22" Height="22" Background="#E0151922" BorderBrush="#66758A"
                                            BorderThickness="1" CornerRadius="11" ToolTipService.ShowDuration="60000"
                                            ToolTip="{Binding VideoInfoText}">
                                        <TextBlock Text="i" Foreground="#DDEEFF" FontSize="12" FontWeight="Bold" FontStyle="Italic"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding DisplayTime}"
                                           Foreground="#98A2B3"
                                           FontSize="12"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding AnnotationTagDisplay}"
                                           Foreground="#66C0F4"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextMenu>
                <ContextMenu Opened="RecordingContextMenu_Opened">
                    <MenuItem Header="Play" Click="PlayMenu_Click"/>
                    <MenuItem Header="Export to MP4…" Click="ExportMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Toggle favorite" Click="FavoriteMenu_Click"/>
                    <MenuItem Header="Edit description…" Tag="Annotation" Click="DescriptionMenu_Click"/>
                    <MenuItem Header="Add/edit tags…" Tag="Annotation" Click="TagsMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Open recording folder" Click="OpenFolderMenu_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

            <Border Grid.Column="1"
                    Background="#10141B"
                    BorderBrush="#252C38"
                    BorderThickness="1,0,0,0">
                <Canvas x:Name="TileDateTimelineCanvas"
                        Margin="5,10,4,10"
                        SizeChanged="DateTimelineCanvas_SizeChanged"
                        IsHitTestVisible="False"/>
            </Border>
        </Grid>

        <Grid x:Name="TableLayoutPanel" Grid.Row="1" Visibility="Collapsed" Background="#0D1015">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#10151D" BorderBrush="#242D39" BorderThickness="0,0,0,1" Padding="16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Game contains" Foreground="#98A2B3" FontSize="11" Margin="1,0,0,4"/>
                        <TextBox x:Name="TableGameFilter" ToolTip="Filter the Game column" TextChanged="TableFilter_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Recording type" Foreground="#98A2B3" FontSize="11" Margin="1,0,0,4"/>
                        <TextBox x:Name="TableTypeFilter" ToolTip="Filter recording type" TextChanged="TableFilter_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Codec contains" Foreground="#98A2B3" FontSize="11" Margin="1,0,0,4"/>
                        <TextBox x:Name="TableCodecFilter" ToolTip="Filter video or audio codec" TextChanged="TableFilter_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Tags, description, or Steam metadata" Foreground="#98A2B3" FontSize="11" Margin="1,0,0,4"/>
                        <TextBox x:Name="TableMetadataFilter" ToolTip="Filter tags, descriptions, and Steam metadata"
                                 TextChanged="TableFilter_TextChanged"/>
                    </StackPanel>
                    <Grid Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,8,0">
                        <Button x:Name="ColumnChooserButton" Content="Columns ▾" Padding="12,6"
                                Click="ColumnChooserButton_Click"/>
                        <Popup x:Name="ColumnChooserPopup" PlacementTarget="{Binding ElementName=ColumnChooserButton}"
                               Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                            <Border Width="270" MaxHeight="520" Margin="0,5,0,0" Padding="10"
                                    Background="#151922" BorderBrush="#3A4353" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Visible columns" Foreground="#F4F7FB" FontWeight="SemiBold"
                                               Margin="3,1,3,8"/>
                                    <ListBox x:Name="ColumnChooserList" Grid.Row="1" Background="#11151C"
                                             BorderBrush="#2B3240" BorderThickness="1"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="ColumnChooserList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="ColumnChooserList_PreviewMouseMove"
                                             DragOver="ColumnChooserList_DragOver"
                                             Drop="ColumnChooserList_Drop"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="⋮⋮" Foreground="#738197" FontSize="14"
                                                               Margin="7,0,3,0" VerticalAlignment="Center"
                                                               Cursor="SizeNS" ToolTip="Drag to reorder" Tag="ColumnDragHandle"/>
                                                    <CheckBox Grid.Column="1" Content="{Binding Name}" IsChecked="{Binding IsVisible}"
                                                              Padding="5" Checked="ColumnVisibility_Changed"
                                                              Unchecked="ColumnVisibility_Changed"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="↑ Move up" Margin="0,0,4,0" Padding="8,5" Click="MoveColumnUp_Click"/>
                                        <Button Grid.Column="1" Content="↓ Move down" Margin="4,0,0,0" Padding="8,5"
                                                Click="MoveColumnDown_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Grid.Column="5" Content="Clear table filters" Padding="12,6" VerticalAlignment="Bottom"
                            Click="ClearTableFilters_Click"/>
                </Grid>
            </Border>

            <DataGrid x:Name="RecordingTable" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      FrozenColumnCount="0" AlternationCount="2"
                      RowStyle="{StaticResource DarkDataGridRow}"
                      CellStyle="{StaticResource DarkDataGridCell}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridHeader}"
                      Background="#0D1015" BorderThickness="0"
                      RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ColumnReordered="RecordingTable_ColumnReordered"
                      MouseDoubleClick="RecordingList_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="FavoriteColumn" Header="★" SortMemberPath="IsFavorite" Width="44">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkDataGridHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Grid>
                                                <Border x:Name="FavoriteHeaderBorder" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Grid>
                                                    <TextBlock Text="★" Foreground="#F6C85F" FontSize="17"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Path x:Name="FavoriteSortUp" Visibility="Collapsed"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,3,3" Fill="#66C0F4" Data="M 0 5 L 3 2 L 6 5 Z"/>
                                                    <Path x:Name="FavoriteSortDown" Visibility="Collapsed"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,3,3" Fill="#66C0F4" Data="M 0 2 L 3 5 L 6 2 Z"/>
                                                    </Grid>
                                                </Border>
                                                <Thumb x:Name="PART_LeftHeaderGripper" Style="{StaticResource TableColumnResizeGrip}"
                                                       HorizontalAlignment="Left" HorizontalContentAlignment="Left" Panel.ZIndex="10"
                                                       DragCompleted="TableColumnResize_DragCompleted"/>
                                                <Thumb x:Name="PART_RightHeaderGripper" Style="{StaticResource TableColumnResizeGrip}"
                                                       HorizontalAlignment="Right" HorizontalContentAlignment="Right" Panel.ZIndex="10"
                                                       DragCompleted="TableColumnResize_DragCompleted"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="FavoriteHeaderBorder" Property="Background" Value="#253044"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="FavoriteHeaderBorder" Property="Background" Value="#2C4058"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Ascending">
                                                    <Setter TargetName="FavoriteSortUp" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Descending">
                                                    <Setter TargetName="FavoriteSortDown" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DarkDataGridCell}">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding TableFavoriteGlyph}" Width="30" Height="28" Padding="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="Transparent" BorderBrush="Transparent"
                                        FontSize="17" ToolTip="Toggle favorite" Click="TableFavorite_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Foreground" Value="#8995A5"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#C7D0DC"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="#F6C85F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Game" Binding="{Binding GameName}" SortMemberPath="GameName" Width="190"
                                        ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="App ID" Binding="{Binding GameId}" SortMemberPath="GameId" Width="82"
                                        ElementStyle="{StaticResource TableNumericText}"/>
                    <DataGridTemplateColumn Header="Type" SortMemberPath="RecordingTypeLabel" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="7,3"
                                        Margin="8,0" CornerRadius="9" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#202733"/>
                                            <Setter Property="BorderBrush" Value="#343E4D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="Background" Value="#54232932"/>
                                                    <Setter Property="BorderBrush" Value="#A84D5B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RecordingTypeLabel}" Foreground="#C7D0DD"
                                               FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Recorded" Binding="{Binding Timestamp, StringFormat={}{0:MMM d, yyyy h:mm tt}}"
                                        SortMemberPath="Timestamp" Width="158" ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" SortMemberPath="DurationSeconds" Width="86"
                                        ElementStyle="{StaticResource TableNumericText}"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="86"
                                        ElementStyle="{StaticResource TableNumericText}"/>
                    <DataGridTextColumn Header="Video codec" Binding="{Binding VideoCodec}" SortMemberPath="VideoCodec" Width="175"
                                        ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" SortMemberPath="Resolution" Width="102"
                                        ElementStyle="{StaticResource TableNumericText}"/>
                    <DataGridTextColumn Header="Frame rate" Binding="{Binding FrameRate}" SortMemberPath="FrameRate" Width="94"
                                        ElementStyle="{StaticResource TableNumericText}"/>
                    <DataGridTextColumn Header="Bitrate" Binding="{Binding Bitrate}" SortMemberPath="Bitrate" Width="94"
                                        ElementStyle="{StaticResource TableNumericText}"/>
                    <DataGridTextColumn Header="Audio codec" Binding="{Binding AudioCodec}" SortMemberPath="AudioCodec" Width="150"
                                        ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" SortMemberPath="SessionCount" Width="96"
                                        ElementStyle="{StaticResource TableNumericText}"/>
                    <DataGridTextColumn Header="Tags" Binding="{Binding AnnotationTagsText}" SortMemberPath="AnnotationTagsText" Width="190"
                                        ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding AnnotationDescription}" SortMemberPath="AnnotationDescription" Width="250">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                                <Setter Property="ToolTip" Value="{Binding AnnotationDescription}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Steam metadata" Binding="{Binding SteamMetadataDisplay}" SortMemberPath="SteamMetadataDisplay" Width="310">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                                <Setter Property="ToolTip" Value="{Binding SteamMetadataDisplay}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding Path}" SortMemberPath="Path" Width="370">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                                <Setter Property="Foreground" Value="#8D99A9"/>
                                <Setter Property="ToolTip" Value="{Binding Path}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="RecordingContextMenu_Opened">
                        <MenuItem Header="Play" Click="PlayMenu_Click"/>
                        <MenuItem Header="Export to MP4…" Click="ExportMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="Toggle favorite" Click="FavoriteMenu_Click"/>
                        <MenuItem Header="Edit description…" Tag="Annotation" Click="DescriptionMenu_Click"/>
                        <MenuItem Header="Add/edit tags…" Tag="Annotation" Click="TagsMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="Open recording folder" Click="OpenFolderMenu_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>

        <!-- One reusable preview popup/decoder is shared by every clip card.
             The thumbnail appears immediately; after a short hover delay the
             muted VideoView replaces it with moving playback. -->
        <Popup x:Name="ClipPreviewPopup"
               Placement="Right"
               HorizontalOffset="14"
               VerticalOffset="0"
               AllowsTransparency="True"
               StaysOpen="True"
               IsHitTestVisible="False">
            <Border Background="#0B0E13"
                    BorderBrush="#3A4353"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <StackPanel>
                    <Border Width="640"
                            Height="360"
                            Background="#05070A"
                            CornerRadius="5"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ClipPreviewThumbnail"
                                   Stretch="Uniform"/>
                            <vlc:VideoView x:Name="ClipPreviewVideoView"
                                           Background="#000000"
                                           Visibility="Hidden"
                                           IsHitTestVisible="False"/>
                            <TextBlock x:Name="ClipPreviewUnavailableText"
                                       Text="Preview unavailable"
                                       Visibility="Collapsed"
                                       Foreground="#98A2B3"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ClipPreviewGameName"
                               Foreground="#F4F7FB"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="2,8,2,0"/>
                    <TextBlock x:Name="ClipPreviewTime"
                               Foreground="#98A2B3"
                               Margin="2,3,2,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <Border Grid.Row="2" Background="#12161E" BorderBrush="#252C38" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Foreground="#98A2B3" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Grid.Column="1"
                           Foreground="#667080" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Keep startup input blocked without applying WPF's light-colored
             disabled state to every control in the dark visual tree. -->
        <Border x:Name="StartupInputBlocker"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#D90D1015"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Finishing startup…"
                           Foreground="#F4F7FB"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Steam Recording Browser will be ready shortly"
                           Foreground="#98A2B3"
                           Margin="0,7,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="LayoutBusyOverlay"
                Grid.RowSpan="3"
                Panel.ZIndex="95"
                Background="#B30D1015"
                Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24,20"
                    Background="#151922"
                    BorderBrush="#2B3240"
                    BorderThickness="1"
                    CornerRadius="9">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="42" Height="42" HorizontalAlignment="Center">
                        <Ellipse Stroke="#303846" StrokeThickness="4"/>
                        <Ellipse Stroke="#66C0F4"
                                 StrokeThickness="4"
                                 StrokeDashArray="2,5"
                                 StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="Updating clip layout…"
                               Foreground="#F4F7FB"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
