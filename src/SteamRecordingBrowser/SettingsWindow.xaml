<Window x:Class="SteamRecordingBrowser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560"
        MinWidth="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1015"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#1B202B"/>
            <Setter Property="BorderBrush" Value="#2B3240"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#11151C"/>
            <Setter Property="BorderBrush" Value="#2B3240"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Manage application shortcuts and preferences."
                       Foreground="#98A2B3" Margin="0,7,0,0"
                       FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,0" Padding="20"
                MinHeight="126"
                Background="#151922" BorderBrush="#2B3240"
                BorderThickness="1" CornerRadius="7">
            <StackPanel>
                <TextBlock Text="Recording folder" FontSize="16" FontWeight="SemiBold"
                           LineHeight="22"/>
                <TextBlock Text="Folder containing your Steam Game Recordings."
                           Margin="0,6,0,12" Foreground="#98A2B3" FontSize="13"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RecordingRootBox" IsReadOnly="True"
                             ToolTip="Steam Game Recording folder"/>
                    <Button Grid.Column="1" Content="Browse…" MinWidth="98"
                            Margin="10,0,0,0" Click="BrowseRecordingRoot_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="20"
                MinHeight="112"
                Background="#151922" BorderBrush="#2B3240"
                BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Metadata" FontSize="16" FontWeight="SemiBold"
                               LineHeight="22"/>
                    <TextBlock Text="Back up or restore favorites, descriptions, and tags."
                               Margin="0,8,0,0" Foreground="#98A2B3" FontSize="13"
                               LineHeight="19" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Back up" MinWidth="92" Margin="0,0,10,0"
                            Click="BackupMetadata_Click"/>
                    <Button Content="Import…" MinWidth="92"
                            Click="ImportMetadata_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,22" Padding="20"
                MinHeight="112"
                Background="#151922" BorderBrush="#2B3240"
                BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="Desktop shortcut" FontSize="16" FontWeight="SemiBold"
                               LineHeight="22"/>
                    <TextBlock x:Name="ShortcutStatusText" Margin="0,8,0,0"
                               Foreground="#98A2B3" FontSize="13"
                               LineHeight="19" TextWrapping="Wrap"/>
                </StackPanel>

                <Button x:Name="CreateShortcutButton" Grid.Column="1"
                        MinWidth="138" VerticalAlignment="Center"
                        Content="Create shortcut"
                        Click="CreateShortcut_Click"/>
            </Grid>
        </Border>

        <Button Grid.Row="4" Content="Close" Width="90"
                HorizontalAlignment="Right" IsCancel="True"
                Click="Close_Click"/>
    </Grid>
</Window>
